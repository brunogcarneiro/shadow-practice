# Copy to .env and export the variables in your shell. Never commit .env.
SHADOW_PRACTICE_RECORDINGS_DIR=recordings
SHADOW_PRACTICE_LOG_DIR=logs
SHADOW_PRACTICE_AUDIO_DEVICE=Aggregate Device
SHADOW_PRACTICE_DEBUG=false
HUGGINGFACE_TOKEN=
OPENAI_API_KEY=
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_REWRITE_MODEL=gpt-5.4-mini
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b-instruct
QWEN_TTS_SERVICE_URL=http://127.0.0.1:8011
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
QWEN_TTS_DEVICE=mps
QWEN_TTS_CACHE_DIR=tts-cache
